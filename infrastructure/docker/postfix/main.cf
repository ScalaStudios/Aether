compatibility_level = 3.6
maillog_file = /var/log/postfix/mail.log
maillog_file_compressor = /bin/true
myhostname = __HOSTNAME__
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8
inet_interfaces = all
inet_protocols = ipv4
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
relayhost = __RELAYHOST__
recipient_delimiter = +
message_size_limit = 52428800
mailbox_size_limit = 0

virtual_mailbox_domains = pgsql:/etc/postfix/pgsql/domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql/mailboxes.cf, pgsql:/etc/postfix/pgsql/coexist-recipients.cf
virtual_alias_domains = $myhostname
virtual_alias_maps = pgsql:/etc/postfix/pgsql/aliases.cf, pgsql:/etc/postfix/pgsql/tagged-mail.cf, tcp:127.0.0.1:10002
virtual_transport = mailbox-lmtp:inet:dovecot:24
mailbox-lmtp_destination_recipient_limit = 1
relay_domains = aether-reports.internal
transport_maps = pgsql:/etc/postfix/pgsql/coexist-transports.cf, regexp:/etc/postfix/coexist_transport_guard, inline:{ aether-reports.internal=lmtp:inet:__REPORTS__ }, pgsql:/etc/postfix/pgsql/outbound-transports.cf
sender_dependent_default_transport_maps = pgsql:/etc/postfix/pgsql/outbound-relays.cf
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql/senders.cf
sender_canonical_maps = pgsql:/etc/postfix/pgsql/hosted-senders.cf, tcp:127.0.0.1:10001
sender_canonical_classes = envelope_sender
sender_bcc_maps = pgsql:/etc/postfix/pgsql/journal.cf
recipient_bcc_maps = pgsql:/etc/postfix/pgsql/journal.cf

smtpd_tls_chain_files = /tls/privkey.pem, /tls/fullchain.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtp_tls_security_level = dane
smtp_tls_policy_maps = pgsql:/etc/postfix/pgsql/outbound-tls.cf
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_authenticated_header = no

smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_client_restrictions = permit_mynetworks, permit_sasl_authenticated
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = check_recipient_access regexp:/etc/postfix/coexist_recipient_guard, reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unlisted_recipient, check_policy_service { inet:__POLICY__, default_action=DUNNO, policy_context=senders }, check_recipient_access pgsql:/etc/postfix/pgsql/restricted-lists.cf, check_recipient_access pgsql:/etc/postfix/pgsql/tagged-rejects.cf
smtpd_restriction_classes = aether_list_policy, aether_suppression_policy
aether_list_policy = check_policy_service inet:__POLICY__
aether_sending_policy = check_policy_service { inet:__POLICY__, policy_context=sending }
aether_suppression_policy = check_policy_service { inet:__POLICY__, policy_context=suppression }
smtpd_sender_restrictions = reject_non_fqdn_sender
smtpd_data_restrictions = reject_unauth_pipelining
nested_header_checks =

smtpd_milters = { inet:__MILTER__, default_action=tempfail }, inet:rspamd:11332, { inet:__MILTER_AFTER__, default_action=tempfail }, { inet:__AUDIT_MILTER__, default_action=accept }
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
milter_header_checks = regexp:/etc/postfix/milter_header_checks, regexp:/etc/postfix/trace_milter_header_checks
header_checks = regexp:/etc/postfix/header_checks, regexp:/etc/postfix/trace_header_checks, regexp:/etc/postfix/coexist_loop_check

smtp_dns_support_level = dnssec
