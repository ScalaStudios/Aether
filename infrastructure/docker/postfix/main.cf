compatibility_level = 3.6
maillog_file = /dev/stdout
myhostname = __HOSTNAME__
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8
inet_interfaces = all
inet_protocols = ipv4
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
relayhost = __RELAYHOST__
recipient_delimiter = +
message_size_limit = 52428800
mailbox_size_limit = 0

virtual_mailbox_domains = pgsql:/etc/postfix/pgsql/domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql/mailboxes.cf
virtual_alias_domains = $myhostname
virtual_alias_maps = pgsql:/etc/postfix/pgsql/aliases.cf, tcp:127.0.0.1:10002
virtual_transport = lmtp:inet:dovecot:24
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql/senders.cf
sender_canonical_maps = pgsql:/etc/postfix/pgsql/hosted-senders.cf, tcp:127.0.0.1:10001
sender_canonical_classes = envelope_sender

smtpd_tls_chain_files = /tls/privkey.pem, /tls/fullchain.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_authenticated_header = no

smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_client_restrictions = permit_mynetworks, permit_sasl_authenticated
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unlisted_recipient
smtpd_sender_restrictions = reject_non_fqdn_sender
smtpd_data_restrictions = reject_unauth_pipelining

smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

smtp_dns_support_level = dnssec
