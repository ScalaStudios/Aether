smtp      inet  n       -       n       -       -       smtpd
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o cleanup_service_name=submission-cleanup
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_non_fqdn_sender,reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=check_recipient_access,regexp:/etc/postfix/coexist_recipient_guard,reject_non_fqdn_recipient,$aether_sending_policy,check_recipient_access,pgsql:/etc/postfix/pgsql/restricted-lists.cf,check_recipient_access,pgsql:/etc/postfix/pgsql/tagged-rejects.cf
  -o milter_macro_daemon_name=ORIGINATING
submissions inet n      -       n       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o cleanup_service_name=submission-cleanup
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_non_fqdn_sender,reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=check_recipient_access,regexp:/etc/postfix/coexist_recipient_guard,reject_non_fqdn_recipient,$aether_sending_policy,check_recipient_access,pgsql:/etc/postfix/pgsql/restricted-lists.cf,check_recipient_access,pgsql:/etc/postfix/pgsql/tagged-rejects.cf
  -o milter_macro_daemon_name=ORIGINATING
10025     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/sieve-relay
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=check_recipient_access,regexp:/etc/postfix/coexist_recipient_guard,reject_non_fqdn_recipient,aether_list_policy
  -o milter_macro_daemon_name=ORIGINATING
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
submission-cleanup unix n -     n       -       0       cleanup
  -o header_checks=regexp:/etc/postfix/submission_header_checks,regexp:/etc/postfix/coexist_loop_check
  -o nested_header_checks=regexp:/etc/postfix/submission_header_checks
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
coexist   unix  -       -       n       -       -       smtp
  -o smtp_generic_maps=regexp:/etc/postfix/coexist_generic
  -o smtp_header_checks=regexp:/etc/postfix/coexist_loop_stamp
  -o smtp_sasl_auth_enable=no
  -o smtp_tls_security_level=may
  -o smtp_tls_policy_maps=
  -o smtp_fallback_relay=
relay     unix  -       -       n       -       -       smtp
  -o syslog_name=postfix/$service_name
smtp-tls  unix  -       -       n       -       -       smtp
  -o syslog_name=postfix/smtp-tls
  -o smtp_tls_security_level=encrypt
aether-outbound unix -  -       n       -       -       smtp
  -o smtp_sasl_auth_enable=no
  -o smtp_tls_security_level=dane
  -o smtp_tls_policy_maps=pgsql:/etc/postfix/pgsql/outbound-tls.cf
aether-sender-auth unix - -     n       -       -       smtp
  -o smtp_sender_dependent_authentication=yes
  -o smtp_sasl_auth_enable=yes
  -o smtp_sasl_security_options=noanonymous,noplaintext
  -o smtp_sasl_tls_security_options=noanonymous
  -o smtp_tls_security_level=encrypt
  -o smtp_tls_policy_maps=pgsql:/etc/postfix/pgsql/outbound-tls-required.cf
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
mailbox-lmtp unix -     -       n       -       -       lmtp flags=O
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
